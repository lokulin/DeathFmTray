<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The 10.0.19041.0 TFM gives us the WinRT projections (Windows.Media.*) needed
         later for System Media Transport Controls, without any extra package refs. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeathFmTray</AssemblyName>
    <RootNamespace>DeathFmTray</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- These flow into the exe's version resource (FileDescription/Product) -
         Windows falls back to reading this for the volume mixer / media flyout
         app name when it can't otherwise resolve a friendly name. -->
    <AssemblyTitle>Death.FM Player</AssemblyTitle>
    <Product>Death.FM Player</Product>
    <Description>A Windows tray wrapper for the Death.FM web player</Description>
    <Company>Terra Eclectic</Company>
    <Version>1.1.1</Version>
    <FileVersion>1.1.1.0</FileVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Platforms>x64</Platforms>
    <StartupObject>DeathFmTray.Program</StartupObject>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed icons in the assembly so single-file publish doesn't need loose Assets\ files. -->
    <EmbeddedResource Include="Assets\app.ico">
      <LogicalName>app.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\tray.ico">
      <LogicalName>tray.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
